# Database Credentials
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password
POSTGRES_DB=fastapi_database

# SQLAlchemy Connection String
# -----------------------------
# 1. For LOCAL development (running 'uv run main.py'):
# Connects to localhost because Docker maps port 5432 to host.
DATABASE_URL=postgresql://myuser:password@localhost:5432/fastapi_database

# 2. For DOCKER (running 'docker compose up backend'):
# Connects to 'db' host within the Docker network.
# Note: docker-compose.yml usually overrides this anyway.
# DATABASE_URL=postgresql://myuser:password@db:5432/fastapi_database
