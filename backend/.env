# ==========================================
# Database Credentials
# ==========================================
# These must match the root .env file if you want to connect to the same DB
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password
POSTGRES_DB=fastapi_database

# ==========================================
# Database Connection String
# ==========================================

# 1. LOCAL DEVELOPMENT (Default)
# Use this when running `uv run fastapi dev ...` locally.
DATABASE_URL=postgresql://myuser:password@localhost:5432/fastapi_database

# 2. DOCKER DEVELOPMENT (Automatic)
# When running `docker-compose up`, the docker-compose.yml file AUTOMATICALLY overrides
# this value to connect to the 'db' container. You do NOT need to change this file for Docker!
# It injects: postgresql://myuser:password@db:5432/fastapi_database

# ==========================================
# Security & Configuration
# ==========================================
SECRET_KEY="v8#x9@kL2$mP5&nQ7*rS4^tW1!zY0(aB3)cD6"
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173", "http://127.0.0.1:5174"]
